{
  "id": "RecyclingVoices1",
  "name": "Recycling notice · three voices",
  "nodes": [
    {
      "id": "90994695-02c5-4a10-94ad-20eb4e18100c",
      "name": "Notice text",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "formTitle": "Recycling notice · three voices",
        "formDescription": "Type the public notice. Kokoro reads it in three voices; every voice passes the AI Act gate before it is published.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Notice text",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "Operator",
              "requiredField": true
            }
          ]
        },
        "options": {
          "path": "notice"
        }
      },
      "webhookId": "a1b2c3d4-0201-4000-8000-hostnotice001"
    },
    {
      "id": "4f6010e1-235a-40ab-b29b-41005ff8f7f4",
      "name": "Three voices",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "jsCode": "// One item per voice. Fields the AI Act gate expects travel with the item (snake_case).\nconst f = $input.first().json;\nconst text = String(f['Notice text'] || '').trim();\nconst operator = String(f['Operator'] || 'unknown');\nconst stamp = new Date().toISOString().slice(0,16).replace(/[:T]/g,'-');\nreturn ['af_bella', 'am_adam', 'bf_emma'].map(voice => ({ json: {\n  voice, text, notice_id: stamp,\n  asset_type: 'audio', language: 'en', model: 'Kokoro-82M', model_version: voice, prompt: text, operator,\n  shows: 'nothing real', origin: 'generated', artistic: 'no', depicts_real_person: 'no', consent_reference: '', public_information: 'yes',\n  caller_workflow: $workflow.name,\n} }));"
      }
    },
    {
      "id": "f39ecaf6-8855-4f3b-a2f7-186a1549a9e0",
      "name": "Kokoro TTS (local)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8880/tts",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text, voice: $json.voice, lang: 'en-us' }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          },
          "timeout": 120000
        }
      }
    },
    {
      "id": "a1192161-63bb-4e09-9f10-3118efe091c0",
      "name": "Attach fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ],
      "parameters": {
        "jsCode": "// The HTTP node returns only the audio; put the item's fields back next to it, in order.\nconst src = $('Three voices').all();\nreturn $input.all().map((it, i) => {\n  const b = it.binary && it.binary.data ? it.binary.data : null;\n  if (b) b.fileName = `${src[i].json.notice_id}-${src[i].json.voice}.wav`;\n  return { json: { ...src[i].json }, binary: it.binary };\n});"
      }
    },
    {
      "id": "4dda31c9-1bfa-47f4-b2db-176d898c8b7f",
      "name": "One voice at a time",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        960,
        300
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "c4a3a7c2-7761-4d1b-9ce9-6112c13a4407",
      "name": "AI Act gate",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1200,
        460
      ],
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "AiActTransparenc"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "3f90c5fa-5cd6-419e-9ec9-0a7e5f8f15dd",
      "name": "Human approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1440,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "14e25d91-8651-4c4f-9759-8a343c13c8ad",
              "leftValue": "={{ $json.approved }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "cb3e0d42-4b44-40d9-a199-24ed00e64eb8",
      "name": "Prepare publish",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        100
      ],
      "parameters": {
        "jsCode": "// Where the approved file goes. One item per approved asset; the two file nodes after this copy it.\nreturn $input.all().filter(it => it.json.labelled_path).map(it => ({ json: { ...it.json,\n  published_path: '/data/published/' + String(it.json.labelled_path).split('/').pop() } }));"
      }
    },
    {
      "id": "aad418aa-3a56-4c5b-93b6-f1aeb348045c",
      "name": "Read approved file",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1920,
        100
      ],
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $json.labelled_path }}",
        "options": {
          "dataPropertyName": "data"
        }
      }
    },
    {
      "id": "58f63edb-a4da-413e-9a44-31061315fa9c",
      "name": "Publish to site [exit]",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        2160,
        100
      ],
      "parameters": {
        "operation": "write",
        "fileName": "={{ $('Prepare publish').item.json.published_path }}",
        "dataPropertyName": "data",
        "options": {}
      }
    },
    {
      "id": "8292ee75-e125-4053-be07-01acf89a455a",
      "name": "Returned, not published",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1680,
        300
      ],
      "parameters": {}
    },
    {
      "id": "df2f5ee2-9a28-44ea-a58a-b772860e3d27",
      "name": "What this line is",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        100
      ],
      "parameters": {
        "width": 1500,
        "height": 110,
        "content": "## A real production line with the kit as a module\nnotice → **Kokoro-82M**, three stock voices (local, no cloned person) → **AI Act gate** (Loop Over Items → Execute Sub-workflow, the parent waits for the human) → publish only what was approved. The publishing node is tagged `[exit]` so the registry knows it reaches people. Voices are stock, so this is `synthetic_media`, not a deep fake."
      }
    }
  ],
